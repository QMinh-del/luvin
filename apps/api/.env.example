NODE_ENV=development
LUVIN_ENV=local
PORT=3000
# Botkeep injects SERVER_PORT. When both are set, SERVER_PORT wins.
DATABASE_URL=postgresql://luvin:luvin@127.0.0.1:5432/luvin_local
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=luvin
MINIO_SECRET_KEY=luvinminio
MINIO_AVATAR_BUCKET=luvin-local-avatars
MINIO_EXPORT_BUCKET=luvin-local-exports

# Private Google Cloud Storage buckets for staging and production (TASK-B06).
GCS_AVATAR_BUCKET=
GCS_EXPORT_BUCKET=

ACCESS_TOKEN_SECRET=

# Auth rate-limit defaults (seconds / max attempts). Override per environment.
AUTH_RATE_LIMIT_WINDOW_SEC=900
AUTH_RATE_LIMIT_REGISTER_MAX=10
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REFRESH_MAX=60
AUTH_RATE_LIMIT_PASSWORD_RESET_MAX=5
AUTH_RATE_LIMIT_EMAIL_CHANGE_MAX=5

GOOGLE_CLOUD_PROJECT=

# Botkeep production. Set these in the panel Environment, never in git.
# Project root is the repository root. Start command is `npm start`.
# Also set NPM_CONFIG_PRODUCTION=false so the Nest build tools install.
# OBJECT_STORAGE_BACKEND=filesystem
# OBJECT_STORAGE_ROOT=/app/data/objects
# PUBLIC_BASE_URL=https://your-botkeep-domain
# DATABASE_SSL_CA=
# REDIS_SSL_CA=
PASSWORD_RECOVERY_ENABLED=false
RESEND_SANDBOX_API_KEY=
RESEND_SANDBOX_FROM=onboarding@resend.dev
RESEND_PRODUCTION_API_KEY=
RESEND_PRODUCTION_FROM=
RESEND_PRODUCTION_DOMAIN_VERIFIED=false
