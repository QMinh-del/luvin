# Allowed LUVIN_ENV values: local | test | development | staging | production
LUVIN_ENV=local
NODE_ENV=development

# API. Botkeep injects SERVER_PORT; when both are set, SERVER_PORT wins.
PORT=3000
DATABASE_URL=postgresql://luvin:luvin@127.0.0.1:5432/luvin_local
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=luvin
MINIO_SECRET_KEY=luvinminio
MINIO_AVATAR_BUCKET=luvin-local-avatars
MINIO_EXPORT_BUCKET=luvin-local-exports

# Private GCS buckets. Required for staging and production when object storage is Google Cloud.
# Botkeep uses filesystem storage instead. Set these in the panel, not in git:
# NPM_CONFIG_PRODUCTION=false
# OBJECT_STORAGE_BACKEND=filesystem
# OBJECT_STORAGE_ROOT=/app/data/objects
# PUBLIC_BASE_URL=https://your-botkeep-domain
# DATABASE_SSL_CA=
# REDIS_SSL_CA=
GCS_AVATAR_BUCKET=
GCS_EXPORT_BUCKET=

# Signing secret for 15-minute access tokens. Use a unique value per environment. Never commit the real secret.
ACCESS_TOKEN_SECRET=

# Observability. Required for Google Cloud staging and production, not for Botkeep filesystem storage.
GOOGLE_CLOUD_PROJECT=

# Password recovery remains disabled until TASK-A08 verifies a production sender.
PASSWORD_RECOVERY_ENABLED=false
RESEND_SANDBOX_API_KEY=
RESEND_SANDBOX_FROM=onboarding@resend.dev
RESEND_PRODUCTION_API_KEY=
RESEND_PRODUCTION_FROM=
RESEND_PRODUCTION_DOMAIN_VERIFIED=false

# Product fallback locale for the mobile app (locked for TASK-B01)
LUVIN_FALLBACK_LOCALE=en

# Authentication rate limits per 15-minute window.
AUTH_RATE_LIMIT_REGISTER_MAX=10
